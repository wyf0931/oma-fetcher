# Set false only for a trusted deployment which must read private hosts.
FETCHER_ALLOW_PRIVATE_NETWORKS=false
# Return a policy error when robots.txt disallows the requested page.
FETCHER_ENFORCE_ROBOTS=true
FETCHER_MAX_RESPONSE_BYTES=5242880
FETCHER_SITEMAP_MAX_URLS=10000
FETCHER_SITEMAP_MAX_DEPTH=4
FETCHER_DISCOVERY_RETRIES=2
FETCHER_DISCOVERY_RETRY_DELAY=0.4
FETCHER_USER_AGENT=oma-fetcher/1.5 (+https://example.invalid/contact)
# Set on to route HTTPX, curl-cffi, Scrapling, and Playwright through PROXY_URL.
PROXY_ENABLED=off
PROXY_URL=http://USERNAME:PASSWORD@p.webshare.io:80/
# Persist only requests which explicitly opt in by default. Set on to persist all fetches.
STORAGE_SAVE_DEFAULT=off
# SQLite database and optional jieba user dictionary paths.
STORAGE_DB_PATH=data/research.db
STORAGE_USER_DICT_PATH=dictionaries/custom.txt
# Cache a successful hostname + target-kind route for seven days.
FETCH_ROUTE_TTL_HOURS=168
# Authentication is opt-in for local development; enable for exposed deployments.
# When on, access requires either a user session cookie or a Bearer API key.
API_AUTH_ENABLED=off
# Random secret used to HMAC client API keys at rest. Required (>=32 chars) when auth is on.
API_KEY_PEPPER=replace-with-a-different-at-least-32-random-secret
# Server-side session lifetime and cookie name for browser (Web UI) logins.
SESSION_TTL_HOURS=168
SESSION_COOKIE_NAME=oma_session
# Optional bootstrap: when the users table is empty and both are set, the service
# creates this first administrator on startup. Leave blank to skip.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
# Set on only for local development: it drops the Secure flag on the session cookie
# so browsers accept it over plain http://localhost.
DEBUG=off
API_DOCS_ENABLED=true
WEB_CORS_ORIGINS=
# MCP: allow extra Host/Origin values when reached by a name other than localhost.
# FETCHLY_MCP_ALLOWED_HOSTS=example.com:*,192.168.1.10:*
# FETCHLY_MCP_ALLOWED_ORIGINS=https://app.example.com
